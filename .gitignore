# =============================================================================
# DustGate — .gitignore
# =============================================================================

# ── PlatformIO ───────────────────────────────────────────────────────────────
.pio/
.pio.nosync/
# Keep platformio.ini, extra_script.py, and source; ignore generated artifacts

# ── Arduino IDE temp / build ──────────────────────────────────────────────────
# Anchored to the repo root ON PURPOSE: a bare `build/` also matched
# dustgate-ui/src/app/build/ (the shop-layout canvas), silently keeping that whole
# component out of version control.
/build/
*.elf
*.bin
*.hex
*.map
*.bak

# Arduino libraries — managed by PlatformIO lib_deps, not checked in
libraries/

# ── Angular (dustgate-ui/) ────────────────────────────────────────────────────
dustgate-ui/node_modules/
dustgate-ui/dist/
dustgate-ui/.angular/
dustgate-ui/.sass-cache/
dustgate-ui/*.js.map

# ── Node (tools/) ────────────────────────────────────────────────────────────
tools/node_modules/
# Secrets — copy tools/.env.example → tools/.env and fill in values; never commit .env
tools/.env

# ── Vercel ───────────────────────────────────────────────────────────────────
.env*.local
.vercel/

# ── LittleFS data dir — generated by deploy.sh, not source ──────────────────
# Uncomment the line below if you want to exclude pre-built UI from the repo.
# firmware/data/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ── iCloud ────────────────────────────────────────────────────────────────────
*.icloud

# ── Editor ───────────────────────────────────────────────────────────────────
# .vscode/ contains absolute paths with the local username — don't share
.vscode/
*.swp
*.swo
*~
.idea/
.claude/
.vercel

# Per-machine USB serial→role pins for dev.sh (see "dev.sh ports --pin").
# Board serials are specific to one bench; never shared.
.dustgate-ports

# routing conformance spec build output
dustgate-ui/.routing-test/
dustgate-ui/.wiring-test/
