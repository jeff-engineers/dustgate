{
  "name": "dustgate-ui",
  "version": "0.1.0",
  "scripts": {
    "start": "ng serve --configuration development",
    "start:mock": "ng serve --configuration development --proxy-config proxy.conf.json",
    "build": "ng build --configuration production",
    "test:routing": "tsc src/app/build/routing/*.ts --outDir .routing-test --module commonjs --target es2022 --moduleResolution node --strict --skipLibCheck && node .routing-test/router.spec.js",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "typescript": "~5.4.0"
  }
}
